From 1296507cc56f33dbfac4ffa629c7a7a8454ea282 Mon Sep 17 00:00:00 2001
From: YimoLieu <yimolieu@163.com>
Date: Wed, 4 Nov 2026 01:59:13 +0800
Subject: [PATCH] fix(cli): read the PKGBUILD license from mygo.json

mygo.json has no license field, so an app without a package.json (no
frontend, native UI, or a Go app that was never npm-packaged) could only
ship LicenseRef-custom, and one with a package.json could not disagree with
the license npm declares.

Read 'license' from mygo.json first, then package.json, and document the
field in configuration.md, distribution.md and the config types.
---
 cmd/mygo/config.go        |  5 +++++
 cmd/mygo/pkgbuild.go      | 13 +++++++++----
 cmd/mygo/pkgbuild_test.go | 23 +++++++++++++++--------
 docs/configuration.md     |  1 +
 docs/distribution.md      |  2 +-
 packages/cli/index.d.ts   |  5 +++++
 6 files changed, 36 insertions(+), 13 deletions(-)

diff --git a/cmd/mygo/config.go b/cmd/mygo/config.go
index fddef7d..97f2f44 100644
--- a/cmd/mygo/config.go
+++ b/cmd/mygo/config.go
@@ -42,6 +42,11 @@ type Config struct {
 	// installed app (default: the copyright notice without its "©" and
 	// years, as "Example Inc." of "Copyright © 2026 Example Inc.").
 	Publisher string `json:"publisher"`
+	// License is the SPDX license expression of the app, such as "MIT" or
+	// "Apache-2.0 WITH LLVM-exception", which the PKGBUILD of Arch Linux
+	// records. It defaults to the license of package.json, for apps whose
+	// frontend declares one (default: package.json's license).
+	License string `json:"license"`
 	// Icon is a square PNG, ideally 1024x1024 (default:
 	// resources/icon.png when it exists). Beside it, the same name with
 	// -dev, as icon-dev.png, is the development app's, when it exists.
diff --git a/cmd/mygo/pkgbuild.go b/cmd/mygo/pkgbuild.go
index fe3c50f..e14400c 100644
--- a/cmd/mygo/pkgbuild.go
+++ b/cmd/mygo/pkgbuild.go
@@ -135,11 +135,16 @@ func packageJSONString(root, key string) string {
 }
 
 // archLicense returns the license of the app for its PKGBUILD: the SPDX
-// expression of package.json, which Arch Linux takes too, else
-// LicenseRef-custom, which says that the license is the app's own, as
-// for UNLICENSED, npm's mark of a package that may not be used freely.
+// expression of mygo.json, else of package.json, which Arch Linux takes
+// too, else LicenseRef-custom, which says that the license is the app's
+// own, as for UNLICENSED, npm's mark of a package that may not be used
+// freely.
 func archLicense(c *Config) string {
-	license := strings.TrimSuffix(strings.TrimPrefix(packageJSONString(c.root, "license"), "("), ")")
+	license := c.License
+	if license == "" {
+		license = packageJSONString(c.root, "license")
+	}
+	license = strings.TrimSuffix(strings.TrimPrefix(license, "("), ")")
 	if license == "" || license == "UNLICENSED" || strings.HasPrefix(license, "SEE LICENSE IN") {
 		return "LicenseRef-custom"
 	}
diff --git a/cmd/mygo/pkgbuild_test.go b/cmd/mygo/pkgbuild_test.go
index 24f1dfd..edc6392 100644
--- a/cmd/mygo/pkgbuild_test.go
+++ b/cmd/mygo/pkgbuild_test.go
@@ -80,18 +80,24 @@ func TestArchDepends(t *testing.T) {
 
 func TestArchLicenseAndURL(t *testing.T) {
 	for _, tc := range []struct {
+		config       string
 		packageJSON  string
 		github       string
 		license, url string
 	}{
-		{"", "", "LicenseRef-custom", ""},
-		{`{"license": "MIT", "homepage": "https://example.com"}`, "me/app", "MIT", "https://example.com"},
-		{`{"license": "(MIT OR Apache-2.0)"}`, "me/app", "MIT OR Apache-2.0", "https://github.com/me/app"},
-		{`{"license": "UNLICENSED"}`, "", "LicenseRef-custom", ""},
-		{`{"license": "SEE LICENSE IN LICENSE.txt"}`, "", "LicenseRef-custom", ""},
-		{`{"license": {"type": "MIT"}}`, "", "LicenseRef-custom", ""},
+		{"", "", "", "LicenseRef-custom", ""},
+		{"", `{"license": "MIT", "homepage": "https://example.com"}`, "me/app", "MIT", "https://example.com"},
+		{"", `{"license": "(MIT OR Apache-2.0)"}`, "me/app", "MIT OR Apache-2.0", "https://github.com/me/app"},
+		{"", `{"license": "UNLICENSED"}`, "", "LicenseRef-custom", ""},
+		{"", `{"license": "SEE LICENSE IN LICENSE.txt"}`, "", "LicenseRef-custom", ""},
+		{"", `{"license": {"type": "MIT"}}`, "", "LicenseRef-custom", ""},
+		// mygo.json's license wins over the one of package.json, which a
+		// frontend may declare for npm rather than for the app.
+		{"MIT", "", "", "MIT", ""},
+		{"(MPL-2.0)", `{"license": "MIT"}`, "", "MPL-2.0", ""},
+		{"UNLICENSED", "", "", "LicenseRef-custom", ""},
 	} {
-		c := &Config{root: t.TempDir()}
+		c := &Config{root: t.TempDir(), License: tc.config}
 		if tc.packageJSON != "" {
 			if err := os.WriteFile(filepath.Join(c.root, "package.json"), []byte(tc.packageJSON), 0o644); err != nil {
 				t.Fatal(err)
@@ -101,7 +107,8 @@ func TestArchLicenseAndURL(t *testing.T) {
 			c.Updates = &Updates{GitHub: tc.github}
 		}
 		if license, url := archLicense(c), archURL(c); license != tc.license || url != tc.url {
-			t.Errorf("package.json %s, updates.github %q: license %q, url %q", tc.packageJSON, tc.github, license, url)
+			t.Errorf("mygo.json license %q, package.json %s, updates.github %q: license %q, url %q",
+				tc.config, tc.packageJSON, tc.github, license, url)
 		}
 	}
 }
diff --git a/docs/configuration.md b/docs/configuration.md
index 77a469b..cf21d36 100644
--- a/docs/configuration.md
+++ b/docs/configuration.md
@@ -49,6 +49,7 @@ the fields of [the frontend](#development-and-the-frontend).
 | `version` | `0.1.0` | the version of the app, which `App.Version()` returns and updates compare |
 | `copyright` | | the copyright notice of the app, in its `Info.plist` (macOS) and file properties (Windows) |
 | `publisher` | the copyright notice without its "©" and years, e.g. `Example Inc.` of `© 2026 Example Inc.` | who makes the app: the publisher that Settings > Apps lists for the installed app on Windows, and its company in the file properties |
+| `license` | `license` in package.json | the SPDX license expression of the app, such as `MIT` or `Apache-2.0 WITH LLVM-exception`, which the PKGBUILD of Arch Linux records |
 | `icon` | `resources/icon.png` when it exists | a square PNG, ideally 1024×1024; its name with `-dev`, as `icon-dev.png`, beside it is the development app's, when it exists |
 | `main` | `.` | the Go package of the app, relative to the project |
 
diff --git a/docs/distribution.md b/docs/distribution.md
index f73ead2..34e6f63 100644
--- a/docs/distribution.md
+++ b/docs/distribution.md
@@ -613,7 +613,7 @@ the archive holds the original. Its fields come from the configuration:
 | `pkgdesc` | `linux.comment`, else the name |
 | `arch` | `x86_64` of amd64, `aarch64` of arm64 |
 | `url` | `homepage` in package.json, else the repository of `updates.github` |
-| `license` | `license` in package.json, else `LicenseRef-custom` |
+| `license` | `license` in mygo.json, else in package.json, else `LicenseRef-custom` |
 | `depends` | `gtk3` and, unless `linux.webview` is `false`, `webkit2gtk-4.1`, then the Arch Linux packages of `linux.depends` that MyGo knows, as `libnotify` of `libnotify4`; the build warns about a Debian package it knows no Arch Linux package for, and leaves it out |
 
 `-upload` leaves the PKGBUILD out: it packages the archive next to it, and
diff --git a/packages/cli/index.d.ts b/packages/cli/index.d.ts
index b4a721c..6b317b2 100644
--- a/packages/cli/index.d.ts
+++ b/packages/cli/index.d.ts
@@ -74,6 +74,11 @@ export interface Config {
    * the copyright notice without its "©" and years).
    */
   publisher?: string;
+  /**
+   * The SPDX license expression of the app, such as `MIT`, which the PKGBUILD
+   * of Arch Linux records (default: `license` in `package.json`).
+   */
+  license?: string;
   /** A square PNG, ideally 1024×1024 (default: `resources/icon.png` when it exists). */
   icon?: string;
   /** The Go package of the app, relative to the project (default: `.`). */
-- 
